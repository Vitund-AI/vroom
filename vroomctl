#!/bin/bash
# vroomctl - manage VRAM-backed block devices.
#   vroomctl add NAME [--size MiB] [--swap | --mount DIR | --raw] [options]
#   vroomctl remove NAME            detach, release the VRAM, forget the device
#   vroomctl stop NAME | start NAME keep the definition, release/reclaim the VRAM
#                                   (after a driver upgrade, stop and remove want --force)
#   vroomctl list                   devices, state and usage
#   vroomctl bench NAME             read-only 4K latency test of a live device
#   vroomctl stats [NAME]           I/O totals, and compression and repeat counts if on
#   vroomctl selftest [--size MiB]  integrity + speed test, no root needed
# add options:
#   --size MiB      device size (default: all free VRAM less 256 MiB)
#   --swap          use as swap (default)      --prio N   swap priority (100)
#   --mount DIR     format ext4 and mount      --mode OCT directory mode (1777)
#   --raw           just the block device, at /dev/vroom/NAME
#   --backend ublk|nbd   kernel interface (default: ublk when available)
#   --gpu N         CUDA index of the GPU (0)
#   --compress      compress pages; the device is RATIO times the VRAM (swap and raw only)
#   --ratio X       how much larger (1.5; 2.2 with --spill)
#   --spill PATH    file or directory on a disk for what does not fit in the VRAM
#   --spill-size MiB   size of that file (default: the size of the device)
#   --cipher aes|chacha20   what a compressed device is encrypted with (aes)
#   --boot          also start at every boot
# Contents never survive a stop or reboot. Definitions live in /etc/vroom/NAME.conf.
set -euo pipefail

CONF_DIR=/etc/vroom
here=$(dirname "$(readlink -f "$0")")

die() { echo "vroomctl: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "this needs root (try sudo)"; }

# A driver upgrade replaces the libraries on disk but leaves the old kernel
# module loaded until reboot. A running daemon keeps the libraries it started
# with and carries on; a daemon started now would get the new ones, which the
# old module refuses. So until reboot nothing can be started, and anything
# stopped stays stopped.
driver_mismatch() {
	local lib
	kver=$(awk 'NR == 1 { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9.]+$/) { print $i; exit } }' \
		"${VROOM_NV_PROC:-/proc/driver/nvidia/version}" 2>/dev/null) || true
	lib=${VROOM_NV_LIB:-$(/sbin/ldconfig -p 2>/dev/null | awk '/libcuda\.so\.1 / { print $NF; exit }')}
	lver=$(basename "$(readlink -f "${lib:-/nonexistent}")")
	lver=${lver#libcuda.so.}
	[[ -n $kver && $lver =~ ^[0-9] && $kver != "$lver" ]]
}
upgraded="the NVIDIA driver has been upgraded since boot"
no_start() {
	if driver_mismatch; then
		die "$upgraded (libraries $lver, kernel module still $kver): nothing can be started until you reboot"
	fi
}

load() {
	name=$1
	[[ $name =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "bad name '$name' (use a-z, 0-9, - and _)"
	[ -r "$CONF_DIR/$name.conf" ] || die "no such device: $name (see 'vroomctl list')"
	VROOM_SIZE_MIB=0 VROOM_MODE=swap VROOM_PRIO=100 VROOM_MOUNT='' VROOM_MOUNT_MODE=1777
	VROOM_COMPRESS=0 VROOM_SPILL='' VROOM_SPILL_MIB=0
	# shellcheck disable=SC1090
	. "$CONF_DIR/$name.conf"
	DEV=$VROOM_DEV
	kname=$(basename "$DEV")
	unit=vroom@$name.service
}

is_swap() { grep -q "^$DEV[[:space:]]" /proc/swaps; }
is_mounted() { grep -q "^$DEV[[:space:]]" /proc/mounts; }
ready() {
	# The node can exist before the device can be opened, so really open it.
	case "$kname" in nbd*) [ -e "/sys/block/$kname/pid" ] || return 1 ;; esac
	[ "$(blockdev --getsize64 "$DEV" 2>/dev/null || echo 0)" != 0 ]
}
claimed() { grep -qsx "VROOM_DEV=$1" "$CONF_DIR"/*.conf; }

pick_dev() {
	local n
	if [ "$1" = ublk ]; then
		for n in $(seq 0 63); do
			[ -e "/dev/ublkb$n" ] || claimed "/dev/ublkb$n" || { echo "/dev/ublkb$n"; return; }
		done
	else
		modprobe nbd
		for n in $(seq 0 63); do
			[ -b "/dev/nbd$n" ] || break
			[ -e "/sys/block/nbd$n/pid" ] || claimed "/dev/nbd$n" || { echo "/dev/nbd$n"; return; }
		done
	fi
	die "no free $1 device"
}

# Take the device out of use. Fails, leaving everything intact, if it is busy.
detach() {
	case "$VROOM_MODE" in
	# Explicit returns: 'set -e' does not apply inside 'detach || ...'.
	swap) if is_swap; then swapoff "$DEV" || return 1; fi ;;
	mount) if is_mounted; then umount "$DEV" || return 1; fi ;;
	esac
	rm -f "/dev/vroom/$name"
}

stop_device() {
	if [ "${1:-}" != --force ] && driver_mismatch; then
		die "$upgraded (libraries $lver, kernel module still $kver).
$name is running normally, but once stopped it cannot be started again until you reboot.
To stop it all the same: vroomctl $cmd $name --force"
	fi
	if is_swap; then echo "swapoff $DEV: pages move back to RAM or other swap, this can take a while..."; fi
	detach || die "$name is still in use; nothing was stopped"
	systemctl stop "$unit"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
add)
	need_root
	name=${1:-}
	[[ $name =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "usage: vroomctl add NAME [options]; NAME uses a-z, 0-9, - and _"
	shift
	size=0 mode=swap prio=100 mnt='' mntmode=1777 backend='' gpu=0 boot=0
	compress=0 ratio='' spill='' spillsize=0 ciph=aes
	while [ $# -gt 0 ]; do
		case "$1" in
		--size) size=${2:?}; shift ;;
		--swap) mode=swap ;;
		--mount) mode=mount; mnt=${2:?}; shift ;;
		--raw) mode=raw ;;
		--prio) prio=${2:?}; shift ;;
		--mode) mntmode=${2:?}; shift ;;
		--backend) backend=${2:?}; shift ;;
		--gpu) gpu=${2:?}; shift ;;
		--boot) boot=1 ;;
		--compress) compress=1 ;;
		--ratio) compress=1; ratio=${2:?}; shift ;;
		--spill) compress=1; spill=${2:?}; shift ;;
		--spill-size) spillsize=${2:?}; shift ;;
		--cipher) compress=1; ciph=${2:?}; shift ;;
		*) die "unknown option: $1" ;;
		esac
		shift
	done
	[[ $size =~ ^[0-9]+$ && $prio =~ ^-?[0-9]+$ && $gpu =~ ^[0-9]+$ && $mntmode =~ ^[0-7]{3,4}$ ]] ||
		die "--size, --prio and --gpu take numbers; --mode takes an octal mode"
	if [ "$mode" = mount ]; then
		[[ $mnt == /* && $mnt != *[[:space:]]* ]] || die "--mount needs an absolute path without spaces"
		if [ -d "$mnt" ] && [ -n "$(ls -A "$mnt")" ]; then
			echo "note: $mnt is not empty; its current contents are hidden while mounted"
		fi
	fi
	[ -e "$CONF_DIR/$name.conf" ] && die "$name already exists (vroomctl remove $name)"
	no_start
	if [ "$compress" = 1 ]; then
		# A full compressed store refuses writes: swap survives that, a filesystem does not.
		[ "$mode" = mount ] && die "--compress is for --swap and --raw, not --mount"
		[ -n "$ratio" ] || { [ -n "$spill" ] && ratio=2.2 || ratio=1.5; }
		[[ $ratio =~ ^[1-7](\.[0-9]+)?$ ]] || die "--ratio takes a number from 1 to 8, such as 1.5"
		[[ $spillsize =~ ^[0-9]+$ ]] || die "--spill-size takes a number of MiB"
		[ "$ciph" = aes ] || [ "$ciph" = chacha20 ] || die "--cipher is aes or chacha20"
		if [ -n "$spill" ]; then
			[[ $spill == /* && $spill != *[[:space:]]* ]] || die "--spill needs an absolute path without spaces"
			[ -d "$spill" ] && spill=${spill%/}/vroom-$name.spill
			[ -d "$(dirname "$spill")" ] || die "--spill: no directory $(dirname "$spill")"
		fi
	else
		ratio=0
	fi
	if [ -z "$backend" ]; then
		if modinfo ublk_drv >/dev/null 2>&1; then backend=ublk; else backend=nbd; fi
	fi
	[ "$backend" = ublk ] || [ "$backend" = nbd ] || die "--backend must be ublk or nbd"

	mkdir -p "$CONF_DIR"
	conf=$CONF_DIR/$name.conf
	{
		echo "VROOM_DEV=$(pick_dev "$backend")"
		echo "VROOM_SIZE_MIB=$size"
		echo "VROOM_GPU=$gpu"
		echo "VROOM_MODE=$mode"
		echo "VROOM_COMPRESS=$ratio"
		[ -n "$spill" ] && printf 'VROOM_SPILL=%s\nVROOM_SPILL_MIB=%s\n' "$spill" "$spillsize"
		[ "$compress" = 1 ] && echo "VROOM_CIPHER=$ciph"
		[ "$mode" = swap ] && echo "VROOM_PRIO=$prio"
		[ "$mode" = mount ] && printf 'VROOM_MOUNT=%s\nVROOM_MOUNT_MODE=%s\n' "$mnt" "$mntmode"
	} > "$conf"
	if ! systemctl start "vroom@$name.service"; then
		journalctl -u "vroom@$name.service" -n 8 --no-pager -o cat >&2 || true
		systemctl reset-failed "vroom@$name.service" 2>/dev/null || true
		rm -f "$conf"
		die "could not start $name; nothing was added"
	fi
	[ "$boot" = 1 ] && systemctl enable -q "vroom@$name.service"
	exec "$0" list
	;;
remove)
	need_root
	load "${1:?usage: vroomctl remove NAME [--force]}"
	stop_device "${2:-}"
	systemctl disable -q "$unit" 2>/dev/null || true
	systemctl reset-failed "$unit" 2>/dev/null || true
	rm -f "$CONF_DIR/$name.conf"
	echo "$name removed"
	;;
stop)
	need_root
	load "${1:?usage: vroomctl stop NAME [--force]}"
	stop_device "${2:-}"
	;;
start)
	need_root
	load "${1:?usage: vroomctl start NAME}"
	no_start
	systemctl start "$unit"
	;;
list | status)
	printf '%-12s %-9s %-13s %9s  %s\n' NAME STATE DEVICE SIZE USE
	for f in "$CONF_DIR"/*.conf; do
		[ -e "$f" ] || continue
		load "$(basename "$f" .conf)"
		state=$(systemctl is-active "$unit" 2>/dev/null || true)
		size=- use=$VROOM_MODE
		if [ -r "/sys/block/$kname/size" ] && [ "$state" = active ]; then
			size="$(($(cat "/sys/block/$kname/size") / 2048)) MiB"
		fi
		case "$VROOM_MODE" in
		swap)
			use="swap, priority $VROOM_PRIO"
			if is_swap; then
				use="$use, $(awk -v d="$DEV" '$1 == d { printf "%.0f MiB used", $4 / 1024 }' /proc/swaps)"
			fi
			;;
		mount)
			use="mounted at $VROOM_MOUNT"
			if is_mounted; then
				use="$use, $(df -BM --output=used "$VROOM_MOUNT" | tail -1 | tr -d ' M') MiB used"
			else
				use="mount $VROOM_MOUNT (not mounted)"
			fi
			;;
		raw) use="raw, /dev/vroom/$name" ;;
		esac
		if [ "$state" = active ]; then
			case "$(sed -n 's/^CIPHER=//p' "/run/vroom/$kname.stat" 2>/dev/null)" in
			none) use="$use; not encrypted" ;;
			?*) use="$use; encrypted" ;;
			esac
		fi
		if [ "$state" = active ] && grep -qs '^COMPRESSED=1' "/run/vroom/$kname.stat"; then
			use="$use; $(. "/run/vroom/$kname.stat"; awk -v p="$PAGES" -v b="$STORED_BYTES" \
				-v v="$VRAM_BYTES" -v s="$SPILLED_BYTES" -v r="$REFUSED" 'BEGIN {
				if (b + s < 1048576) printf "compressing, nearly empty"
				else printf "compressed %.2fx, VRAM %d%% full", p * 4096 / (b + s), b * 100 / v
				if (s) printf ", %d MiB on disk", s / 1048576
				if (r) printf ", %d WRITES REFUSED (full)", r }')"
		fi
		printf '%-12s %-9s %-13s %9s  %s\n' "$name" "$state" "$DEV" "$size" "$use"
	done
	if command -v nvidia-smi >/dev/null; then
		nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv,noheader |
			sed 's/^/GPU /'
	fi
	if driver_mismatch; then
		echo "WARNING: $upgraded (libraries $lver, kernel module still $kver)."
		echo "         Running devices are unaffected, but none can be started until you reboot: do not stop them."
	fi
	if grep -qs 'PreserveVideoMemoryAllocations: 0' /proc/driver/nvidia/params; then
		echo "WARNING: the driver does not preserve VRAM across suspend; suspending destroys device contents"
	fi
	;;
stats)
	for f in "$CONF_DIR"/${1:-*}.conf; do
		[ -e "$f" ] || die "no such device: ${1:-} (see 'vroomctl list')"
		load "$(basename "$f" .conf)"
		[ -r "/sys/block/$kname/size" ] || { echo "$name: not running"; continue; }
		swapkb=$(awk -v d="$DEV" '$1 == d { print $4 }' /proc/swaps)
		mnt=''
		if [ "$VROOM_MODE" = mount ] && is_mounted; then mnt=$VROOM_MOUNT; fi
		# Sizes, rates and times are printed in whatever unit suits the number.
		awk -v name="$name" -v dev="$DEV" -v sectors="$(cat "/sys/block/$kname/size")" \
			-v swapkb="${swapkb:--1}" -v mnt="$mnt" '
		function size(b) {
			if (b < 1024) return sprintf("%d B", b)
			if (b < 1048576) return sprintf("%.3g KiB", b / 1024)
			if (b < 1073741824) return sprintf("%.3g MiB", b / 1048576)
			return sprintf("%.3g GiB", b / 1073741824)
		}
		function rate(b) { return b < 1 ? "-" : size(b) "/s" }
		function count(n) {
			if (n < 10000) return sprintf("%d", n)
			if (n < 1e7) return sprintf("%.3g k", n / 1e3)
			if (n < 1e10) return sprintf("%.3g M", n / 1e6)
			return sprintf("%.3g G", n / 1e9)
		}
		function took(ns) {
			if (ns < 1) return "-"
			if (ns < 1e6) return sprintf("%.3g us", ns / 1e3)
			if (ns < 1e9) return sprintf("%.3g ms", ns / 1e6)
			return sprintf("%.3g s", ns / 1e9)
		}
		function up(s) {
			if (s < 120) return s " s"
			if (s < 7200) return int(s / 60) " min"
			if (s < 172800) return int(s / 3600) " h " int(s % 3600 / 60) " min"
			return int(s / 86400) " days " int(s % 86400 / 3600) " h"
		}
		function row(what, dir, k,   f, w, o) {
			if (!(k in perf)) return 0
			split(perf[k], f, " ")
			if (!f[2]) return 0
			printf "  %-9s %-5s %10s %8s %11s %11s", what, dir, size(f[3]), count(f[2]), \
				f[18] > 0 ? rate(f[17] / f[18] * 1e9) : "-", rate(f[4])
			for (w = 0; w < 2; w++) {
				o = 5 + w * 6
				printf "   %11s %8s %8s %8s", rate(f[o + 2]), took(f[o + 3]), took(f[o + 4]), took(f[o + 5])
			}
			print ""
			return 1
		}
		/^#perf / { perf[$2] = $0; sub(/^#perf /, "", perf[$2]); next }
		/=/ { split($0, kv, "="); v[kv[1]] = kv[2] }
		END {
			printf "%s   %s", name, dev
			if ("UPTIME" in v) printf "   up %s", up(v["UPTIME"])
			print ""
			printf "  %-12s %s offered", "size", size(sectors * 512)
			if ("VRAM_BYTES" in v) printf ", on %s of VRAM", size(v["VRAM_BYTES"])
			if (v["SPILL_BYTES"] > 0) printf " and a %s spill file", size(v["SPILL_BYTES"])
			print ""
			if (swapkb >= 0) printf "  %-12s %s as swap\n", "in use", size(swapkb * 1024)
			if (mnt != "") printf "  %-12s mounted at %s\n", "in use", mnt
			if (v["COMPRESSED"]) {
				b = v["STORED_BYTES"]; s = v["SPILLED_BYTES"]; p = v["PAGES"]
				printf "  %-12s %s of pages in %s of VRAM", "holding", size(p * 4096), size(b)
				if (s > 0) printf " and %s on disk", size(s)
				if (b + s >= 1048576) printf "  (%.2fx)", p * 4096 / (b + s)
				printf "\n  %-12s %d%% full\n", "VRAM", b * 100 / v["VRAM_BYTES"]
				if (p > 0 && v["RECORDS"] > 0)
					printf "  %-12s %.1f%% of pages are a copy of another\n", "sharing", (p - v["RECORDS"]) * 100 / p
				if (v["REFUSED"] > 0)
					printf "  %-12s %d WRITES, because the store was full\n", "REFUSED", v["REFUSED"]
			}
			if (v["CIPHER"] == "aes") c = "AES-256-GCM, key only in the daemon'\''s memory"
			else if (v["CIPHER"] == "chacha20") c = "ChaCha20-Poly1305, key only in the daemon'\''s memory"
			else if (v["CIPHER"] == "none") c = "none: pages are on the card as they are"
			if (c != "") printf "  %-12s %s\n", "encryption", c
			if (!("req_read" in perf)) exit
			printf "\n  %-15s %43s   %38s   %38s\n", "", "---------------- since start --------------", \
				"------------- last 60 s --------------", "------------- last 5 min -------------"
			printf "  %-15s %10s %8s %11s %11s   %11s %8s %8s %8s   %11s %8s %8s %8s\n", "", "total", "count", \
				"speed", "peak rate", "rate", "p50", "p95", "p99", "rate", "p50", "p95", "p99"
			n = row("requests", "read", "req_read") + row("", "write", "req_write")
			n += row("VRAM", "read", "vram_read") + row("", "write", "vram_write")
			n += row("spill", "read", "disk_read") + row("", "write", "disk_write")
			if (!n) print "  nothing read or written yet"
			else {
				print "  speed: how fast data moves while an operation is under way."
				print "  rate:  how much moved per second of real time; the peak is the busiest 2 seconds."
				printf "  speed and times come from timing 1 operation in %d.\n", v["SAMPLE"]
			}
		}' "/run/vroom/$kname.stat" 2>/dev/null || echo "$name ($DEV): no figures from its daemon"
		if [ -r "/run/vroom/$kname.count" ]; then
			(. "/run/vroom/$kname.count"; awk -v w="$WRITES" -v z="$ZERO" -v sb="$SAME_BLOCK" \
				-v bo="$BOUNCED" -v du="$DUPLICATE" -v fr="$FRESH" 'BEGIN {
				if (!w) { print "  pages written: none yet"; exit }
				printf "  pages written %d, of which\n", w
				printf "    %5.1f%%  new to the device\n", fr * 100 / w
				printf "    %5.1f%%  already held, and read back since (out, in, out again)\n", bo * 100 / w
				printf "    %5.1f%%  already held in another block\n", du * 100 / w
				printf "    %5.1f%%  the same as what the block held\n", sb * 100 / w
				printf "    %5.1f%%  all zeros\n", z * 100 / w }')
		fi
	done
	;;
bench)
	load "${1:?usage: vroomctl bench NAME}"
	exec "$here/vroom" --bench "$DEV"
	;;
selftest)
	exec "$here/vroom" --selftest "$@"
	;;
_prepare) # ExecStartPre: load the kernel side of the chosen backend
	load "$1"
	case "$kname" in
	ublkb*) modprobe ublk_drv ;;
	nbd*) modprobe nbd ;;
	*) die "VROOM_DEV must be /dev/nbdN or /dev/ublkbN, not $DEV" ;;
	esac
	;;
_attach) # ExecStartPost: the daemon is starting; wait for the device, then put it to use
	load "$1"
	for _ in $(seq 300); do
		ready && break
		[ -z "${MAINPID:-}" ] || [ -d "/proc/$MAINPID" ] || die "vroom daemon exited"
		sleep 0.1
	done
	ready || die "$DEV did not come up"
	mkdir -p /dev/vroom
	ln -sfn "$DEV" "/dev/vroom/$name"
	label=vroom-$name
	case "$VROOM_MODE" in
	swap)
		mkswap -L "${label:0:15}" "$DEV" >/dev/null
		# A compressed store wants to hear when the kernel frees swap, so it can free it too.
		if [ "$VROOM_COMPRESS" != 0 ]; then
			swapon --discard -p "$VROOM_PRIO" "$DEV"
		else
			swapon -p "$VROOM_PRIO" "$DEV"
		fi
		;;
	mount)
		# Contents are volatile, so no journal and no reserved blocks.
		mkfs.ext4 -q -F -m 0 -O ^has_journal -L "${label:0:16}" "$DEV"
		mkdir -p "$VROOM_MOUNT"
		mount -o noatime "$DEV" "$VROOM_MOUNT"
		chmod "$VROOM_MOUNT_MODE" "$VROOM_MOUNT"
		;;
	esac
	;;
_detach) # ExecStop: must succeed before the daemon is asked to exit
	load "$1"
	detach
	;;
*)
	sed -n '2,25p' "$0" >&2
	exit 1
	;;
esac
