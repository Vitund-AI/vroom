[Unit]
Description=VRAM-backed block device %i (vroom)
# After the disk swap: units stop in the reverse order, so at shutdown our
# swapoff runs while the disk swap is still there to take the pages.
After=nvidia-persistenced.service swap.target

[Service]
Type=exec
Environment=VROOM_SIZE_MIB=0 VROOM_GPU=0 VROOM_THREADS=0 VROOM_COMPRESS=0 VROOM_SPILL= VROOM_SPILL_MIB=0
EnvironmentFile=/etc/vroom/%i.conf
ExecStartPre=@SBINDIR@/vroomctl _prepare %i
ExecStart=@SBINDIR@/vroom --dev ${VROOM_DEV} --size ${VROOM_SIZE_MIB} --gpu ${VROOM_GPU} --threads ${VROOM_THREADS} --compress ${VROOM_COMPRESS} --spill ${VROOM_SPILL} --spill-size ${VROOM_SPILL_MIB}
ExecStartPost=@SBINDIR@/vroomctl _attach %i
ExecStop=@SBINDIR@/vroomctl _detach %i

# The VRAM holds the only copy of the data. Never SIGKILL the daemon: if
# swapoff or umount cannot complete, leave it running rather than lose it.
# (The daemon itself ignores SIGTERM while its device is swap or mounted.)
KillMode=mixed
SendSIGKILL=no
TimeoutStopSec=15min
# A restart cannot bring lost pages back, so do not pretend it can.
Restart=no

OOMScoreAdjust=-1000
# The daemon rules out core dumps itself; this is the same from outside.
LimitCORE=0
LimitMEMLOCK=infinity
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
