#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	# does nothing unless there are swap devices: see the unit
	systemctl enable vroom-sleep.service >/dev/null 2>&1 || true
fi
if [ "$1" = configure ] && [ -z "$2" ]; then
	echo "vroom: installed. Try 'vroomctl selftest', then e.g."
	echo "vroom:   vroomctl add swap --swap"
	echo "vroom:   vroomctl add scratch --size 2048 --mount /mnt/scratch"
fi
