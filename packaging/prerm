#!/bin/sh
set -e
# On removal every device must be drained and stopped first; if one is busy,
# abort the removal rather than strand a daemon holding live data. Upgrades
# leave running daemons alone (the new binary is used from the next start).
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	for conf in /etc/vroom/*.conf; do
		[ -e "$conf" ] || continue
		name=$(basename "$conf" .conf)
		systemctl disable "vroom@$name.service" >/dev/null 2>&1 || true
		vroomctl stop "$name" --force
	done
fi
